<?xml version="1.0"?>
<robot name="moving_obstacle_1">
  <gazebo>
    <static>false</static>
    <gravity>false</gravity>
  </gazebo>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.4" radius="0.1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.4" radius="0.1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0175" ixy="0.0" ixz="0.0"
               iyy="0.0175" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>


  <gazebo reference="base_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>0.0</kp>
    <kd>0.0</kd>
    <maxContacts>0</maxContacts>
  </gazebo>

</robot>
